{
  "pipeline": {
    "quality_gate": true,
    "enhancement": true,
    "lesion_evidence": true,
    "agreement_check": true,
    "deferral": true
  },
  "grading": {
    "backbone": "resnet50",
    "input_size": 448,
    "head": "ordinal",
    "batch_size": 12,
    "seed": 42
  },
  "operating_point": { "referable_threshold": null, "frozen_on": null },
  "decision_policy": {
    "referableThreshold": 0.70,
    "autoClearThreshold": 0.20,
    "uncertaintyThreshold": 0.50,
    "requireEvidenceForAutoClear": true,
    "alwaysEscalateLevel4": true,
    "escalateOnUnknownEvidence": true,
    "escalateOnExplanationDisagreement": true
  }
}
