{
  "ablation": {
    "id": "A3",
    "configuration": "Lesion detection + ICDR rules only, no CNN",
    "establishes": "The fully interpretable baseline. Expected to be weakest on raw accuracy; its value is as the interpretable reference and the source of the agreement check.",
    "uses_cnn": false,
    "source": "docs/SIH26038_design.html \u00a711.6",
    "note": "Inherits preprocessing, grading, data and operating_point from config/default.json so every ablation runs the frozen model at the frozen threshold. Only the pipeline block and the decision composition differ."
  },
  "pipeline": {
    "quality_gate": false,
    "enhancement": false,
    "lesion_evidence": true,
    "agreement_check": false,
    "deferral": false,
    "learned_lesion_evidence": false
  },
  "preprocessing": {
    "output_type": "single",
    "channel_mean": [
      0,
      0,
      0
    ],
    "channel_std": [
      0.00392156862745098,
      0.00392156862745098,
      0.00392156862745098
    ]
  },
  "grading": {
    "backbone": "resnet50",
    "input_size": 448,
    "head": "softmax",
    "num_classes": 5,
    "batch_size": 16,
    "seed": 42,
