{
  "pipeline": {
    "quality_gate": true,
    "enhancement": true,
    "lesion_evidence": true,
    "agreement_check": true,
    "deferral": true
  },
  "preprocessing": {
    "output_type": "single",
    "channel_mean": [0, 0, 0],
    "channel_std": [0.00392156862745098, 0.00392156862745098, 0.00392156862745098]
  },
  "grading": {
    "backbone": "resnet50",
    "input_size": 448,
    "head": "softmax",
    "num_classes": 5,
    "batch_size": 16,
    "seed": 42
  },
  "training": {
    "max_epochs": 10,
    "learning_rate": 0.00002,
    "warmup_epochs": 2,
    "warmup_learning_rate": 0.001,
    "gradient_threshold": 10,
    "dispatch_in_background": false,
    "augmentation": true,
    "gradient_decay_factor": 0.9,
    "squared_gradient_decay_factor": 0.999,
    "epsilon": 0.00000001,
    "smoke_epochs": 1,
    "smoke_examples_per_class": 2,
    "smoke_batch_size": 2,
    "smoke_freeze_backbone": true
  },
  "class_balancing": {
    "method": "inverse_frequency",
    "oversampling": true
  },
  "data": {
    "dataset": "APTOS"
  },
  "operating_point": { "referable_threshold": null, "frozen_on": null },
  "decision_policy": {
    "referableThreshold": 0.70,
    "autoClearThreshold": 0.20,
    "uncertaintyThreshold": 0.50,
    "requireEvidenceForAutoClear": true,
    "alwaysEscalateLevel4": true,
    "escalateOnUnknownEvidence": true,
    "escalateOnExplanationDisagreement": true
  }
}
